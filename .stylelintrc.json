{
  "extends": "stylelint-config-standard",
  "rules": {
    "custom-property-no-missing-var-function": null,
    "property-no-unknown": [
      true,
      {
        "ignoreProperties": ["/^--/"]
      }
    ],
    "property-no-vendor-prefix": [
      true,
      {
        "ignoreProperties": ["-webkit-user-select"]
      }
    ]
  }
}
