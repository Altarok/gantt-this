{
  "name": "gantt-this",
  "version": "0.0.1",
  "description": "Proof of concept for TTRPG Gantt timeline",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "lint:css": "stylelint \"styles.css\""
  },
  "dependencies": {
    "d3": "^7.9.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "obsidian": "^1.12.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "builtin-modules": "^5.2.0",
    "typescript": "^5.5.3"
  },
  "private": true,
  "allowScripts": {
    "esbuild@0.28.0": true
  }
}
