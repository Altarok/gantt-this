{
  "name": "gantt-this",
  "version": "0.0.1",
  "private": true,
  "description": "Proof of concept for TTRPG Gantt timeline",
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "format:json": "sort-package-json package.json",
    "lint": "eslint .",
    "lint:css": "stylelint \"styles.css\"",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^14.0.0",
    "obsidian": "1.12.3",
    "sort-package-json": "^4.0.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
